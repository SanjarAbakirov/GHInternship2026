# Copy to .env (gitignored) and adjust values before: docker compose up -d
# Spring Boot reads the same names via application.properties / application-local.properties

POSTGRES_DB=internship_db
POSTGRES_USER=internship_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# Optional: full JDBC URL override (defaults are built from the vars above)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/internship_db
# SPRING_DATASOURCE_USERNAME=internship_user
# SPRING_DATASOURCE_PASSWORD=change_me_strong_password
