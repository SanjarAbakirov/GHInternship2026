# ==============================================================================
# Шаблон переменных окружения для GHInternship2026
# Скопируйте в .env (`cp .env.example .env`) и укажите реальные локальные значения.
# ВНИМАНИЕ: Файл .env исключен из Git (.gitignore) — НЕ коммитьте секреты!
# ==============================================================================

# PostgreSQL (Docker Compose / локальная БД)
POSTGRES_DB=gh_internship_db
POSTGRES_USER=gh_app_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_LOCAL_DB_PASSWORD
POSTGRES_PORT=5432

# Spring Boot DataSource (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/gh_internship_db
DB_USERNAME=gh_app_user
DB_PASSWORD=CHANGE_ME_STRONG_LOCAL_DB_PASSWORD

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# External AI Service API Key
AI_SERVICE_API_KEY=YOUR_DEV_AI_API_KEY_HERE
AI_SERVICE_API_URL=https://api.openai.com/v1/chat/completions

# JWT Secret (минимум 256 бит, строка Base64 или >= 32 байт)
JWT_SECRET=Y2hhbmdlLXRoaXMtZGV2LWp3dC1zZWNyZXQta2V5LXRvLWEtMjU2LWJpdC1zZWNyZXQ=
JWT_EXPIRATION_MS=86400000

