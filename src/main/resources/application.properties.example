spring.application.name=GHInternship2026

# 1. Параметры подключения к DataSource
spring.datasource.url=jdbc:h2:mem:testdb
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=

# Hibernate JPA settings
spring.jpa.hibernate.ddl-auto=create-drop

# sql requests - logs
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# H2 Console
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

# --------------------------------------------------
# CORS (Cross-Origin Resource Sharing) Configuration
# --------------------------------------------------
# Разрешенные origins для ReactJS серверов разработки (CRA порт 3000, Vite порт 5173).
# Для продакшена переопределяется через переменную окружения CORS_ALLOWED_ORIGINS.
app.cors.allowed-origins=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
app.cors.allowed-methods=GET,POST,PUT,DELETE,OPTIONS,PATCH,HEAD
app.cors.allowed-headers=*
app.cors.allow-credentials=true
app.cors.max-age=3600

# --------------------------------------------------
# External AI Service Configuration
# --------------------------------------------------
# URL эндпоинта внешнего AI-сервиса (по умолчанию OpenAI Chat Completions API)
ai.service.api-url=${AI_SERVICE_API_URL:https://api.openai.com/v1/chat/completions}
# Шаблон ключа для локальной разработки.
# Скопируйте данный файл в application.properties и укажите реальный локальный ключ:
# cp src/main/resources/application.properties.example src/main/resources/application.properties
# В продакшене переопределяется через переменную окружения AI_SERVICE_API_KEY.
ai.service.api-key=${AI_SERVICE_API_KEY:YOUR_DEV_AI_API_KEY_HERE}

# --------------------------------------------------
# JWT Authentication Configuration
# --------------------------------------------------
# Секретный ключ для подписи JWT-токенов (минимум 256 бит для HS256).
# В продакшене ОБЯЗАТЕЛЬНО задайте безопасный ключ через переменную окружения JWT_SECRET!
jwt.secret=${JWT_SECRET:Y2hhbmdlLXRoaXMtZGV2LWp3dC1zZWNyZXQta2V5LXRvLWEtMjU2LWJpdC1zZWNyZXQ=}
# Время жизни JWT-токена в миллисекундах (по умолчанию 24 часа = 86400000 мс)
jwt.expiration-ms=${JWT_EXPIRATION_MS:86400000}

